# Kaleta
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # some hosts do not pass the Authorization header to PHP (the Claude connection needs it)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # /.well-known/: files (domain verification, the HTTPS certificate from Let's Encrypt or AutoSSL) are served directly;
    # the OAuth metadata for the Claude connector (oauth-…) comes from index.php below
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^\.well-known/ - [L]
    # config.php and hidden files are not for visitors
    RewriteRule ^(config(\.sample)?\.php|\.(?!well-known/).*)$ - [F,L]
    # publisher tools, documentation and PHP files of layouts (from older releases) are never run or read from the web
    RewriteRule ^(tools|docs|dist)(/|$) - [F,L]
    RewriteRule ^layout/.+\.php$ - [F,L]
    # add-ons (3.3.2): only the public/ folder of an add-on is served (its images, styles, scripts – never PHP); the code,
    # extension.json and install.sql of every add-on, switched on or off, are not for visitors. 3.19.1: also run.php/x
    # (path info) and run.php.x, and nothing in public/ but an existing file – content negotiation (MultiViews) would
    # otherwise pick run.php for /run
    RewriteRule ^extensions/[^/]+/public/.+\.(php\d?|pht|phps|phtml|phar)(\.|/|$) - [F,L,NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^extensions/[^/]+/public/ - [F,L,NC]
    RewriteRule ^extensions/(?![^/]+/public/) - [F,L,NC]
    # The folder of the site as part of the URL (empty = the domain root, otherwise e.g. /web). The rewrite targets below are
    # written as URLs, not as relative paths: some hosts map subdomains to a folder outside the web root, where a relative
    # target ends in a redirect loop and error 500. A URL works everywhere – in the root, in a subfolder and on a subdomain.
    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule .* - [E=BASE:%1]

    # images from media/: a browser that accepts AVIF (smallest) or WebP gets the sibling file photo.jpg.avif / .webp
    RewriteCond %{HTTP_ACCEPT} image/avif
    RewriteCond %{REQUEST_FILENAME}.avif -f
    RewriteRule ^(media/.+\.(?:jpe?g|png))$ %{ENV:BASE}/$1.avif [T=image/avif,E=webp:1,L]
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{REQUEST_FILENAME}.webp -f
    RewriteRule ^(media/.+\.(?:jpe?g|png))$ %{ENV:BASE}/$1.webp [T=image/webp,E=webp:1,L]

    # everything that is not an existing file or folder goes to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ %{ENV:BASE}/index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header append Vary Accept env=REDIRECT_webp
</IfModule>

# static files: their URLs carry the version (?v=…), so browsers may keep them long; sw.js must always be revalidated
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType image/avif .avif
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/avif "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <Files "sw.js">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/rss+xml application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>
