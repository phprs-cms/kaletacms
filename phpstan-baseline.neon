parameters:
	ignoreErrors:
		-
			message: '#^Strict comparison using \!\=\= between array\<string, mixed\> and null will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: system/src/Admin/Kernel.php

		-
			message: '#^Offset ''obsah'' on non\-empty\-array on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: system/src/Builder/Build.php

		-
			message: '#^Match expression does not handle remaining value\: string$#'
			identifier: match.unhandled
			count: 1
			path: system/src/Builder/CollectionSchema.php

		-
			message: '#^Offset 1 on array\{non\-empty\-string, '''', non\-falsy\-string\}\|array\{non\-empty\-string, non\-falsy\-string\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 2
			path: system/src/Builder/Collections.php

		-
			message: '#^Call to function is_array\(\) with array\<string, mixed\> will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: system/src/Builder/Edits.php

		-
			message: '#^Parameter \#1 \$array \(list\<array\<string, mixed\>\>\) of array_values is already a list, call has no effect\.$#'
			identifier: arrayValues.list
			count: 1
			path: system/src/Builder/Edits.php

		-
			message: '#^Strict comparison using \!\=\= between mixed and null will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: system/src/Builder/Edits.php

		-
			message: '#^Call to an undefined method Dom\\Document\:\:saveHtml\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: system/src/Builder/HtmlConverter.php

		-
			message: '#^Method Kaleta\\Builder\\HtmlConverter\:\:figure\(\) never returns null so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: system/src/Builder/HtmlConverter.php

		-
			message: '#^Parameter &\$skipped by\-ref type of method Kaleta\\Builder\\HtmlConverter\:\:withoutClasses\(\) expects list\<string\>, array given\.$#'
			identifier: parameterByRef.type
			count: 1
			path: system/src/Builder/HtmlConverter.php

		-
			message: '#^Strict comparison using \!\=\= between array\{\} and array\{\} will always evaluate to false\.$#'
			identifier: notIdentical.alwaysFalse
			count: 1
			path: system/src/Builder/HtmlConverter.php

		-
			message: '#^Using nullsafe property access "\?\-\>textContent" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 2
			path: system/src/Builder/HtmlConverter.php

		-
			message: '#^Result of \|\| is always false\.$#'
			identifier: booleanOr.alwaysFalse
			count: 1
			path: system/src/Core/Look.php

		-
			message: '#^Strict comparison using \=\=\= between array\{design_system\?\: array\<string, mixed\>, classes\: array\<string, array\|null\>, menus\?\: array\<string, array\|null\>, identity\?\: array\<string, string\>\} and array\{classes\: array\{\}\} will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: system/src/Core/Look.php

		-
			message: '#^Strict comparison using \=\=\= between array\{design_system\?\: array\<string, mixed\>, classes\: array\<string, array\|null\>, menus\?\: array\<string, array\|null\>, identity\?\: array\<string, string\>\} and array\{\} will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: system/src/Core/Look.php

		-
			message: '#^Binary operation "%%" between int and 0\|1\|2\|4\|5\|8\|9\|10\|11\|13\|14\|16\|17\|18\|20\|21\|23\|25\|26\|28\|29\|31\|33\|35\|37\|38\|40\|43\|45\|47\|49 results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: system/src/Core/Qr.php

		-
			message: '#^Method Kaleta\\Core\\RemoteBackup\:\:ftp\(\) should return array\{callable\(string, string\)\: void, callable\(\)\: void\} but returns array\{Closure\(string, string\)\: void, Closure\(\)\: bool\}\.$#'
			identifier: return.type
			count: 1
			path: system/src/Core/RemoteBackup.php

		-
			message: '#^Negated boolean expression is always true\.$#'
			identifier: booleanNot.alwaysTrue
			count: 1
			path: system/src/Core/RemoteBackup.php

		-
			message: '#^Match expression does not handle remaining value\: string$#'
			identifier: match.unhandled
			count: 1
			path: system/src/Core/SiteImport.php

		-
			message: '#^Empty array passed to foreach\.$#'
			identifier: foreach.emptyArray
			count: 1
			path: system/src/Core/Updater.php

		-
			message: '#^Comparison operation "\<\=" between 30 and 0 is always false\.$#'
			identifier: smallerOrEqual.alwaysFalse
			count: 1
			path: system/src/Core/WpImport.php

		-
			message: '#^PHPDoc tag @param references unknown parameter\: \$meta$#'
			identifier: parameter.notFound
			count: 1
			path: system/src/Front/Kernel.php

		-
			message: '#^Using nullsafe property access "\?\-\>withoutCache" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: system/src/Front/Kernel.php

		-
			message: '#^Offset 0\|1\|2\|3 on array\{array\{''uvod'', ''vyhody'', ''cisla'', ''reference'', ''novinky'', ''vyzva''\}, array\{\}, array\{''nadpis\-stranky'', ''sluzby'', ''faq'', ''vyzva''\}, array\{''nadpis\-stranky'', ''kontakt'', ''poptavka''\}\}\|array\{array\{''uvod\-obrazek'', ''zaruky'', ''proces'', ''portfolio'', ''reference'', ''vyzva''\}, array\{''nadpis\-stranky'', ''pribeh'', ''hodnoty'', ''tym''\}, array\{''nadpis\-stranky'', ''strida'', ''sluzby\-seznam'', ''faq'', ''vyzva\-pruh''\}, array\{''nadpis\-stranky'', ''kontakt\-formular''\}\}\|array\{array\{''uvod\-stred'', ''loga'', ''vyhody\-seznam'', ''cisla\-svetla'', ''reference\-jedna'', ''vyzva''\}, array\{''nadpis\-stranky'', ''pribeh'', ''tym'', ''historie'', ''kariera''\}, array\{''nadpis\-stranky'', ''sluzby'', ''cenik'', ''faq\-dva''\}, array\{''nadpis\-stranky'', ''kontakt\-formular'', ''pobocky''\}\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: system/src/Install/Installer.php

		-
			message: '#^Offset ''revize'' does not exist on array\{druh\: string, radek\: array\<string, mixed\>, stavba\: string\|null, koncept\: string\|null, jazyk\: string\}\.$#'
			identifier: offsetAccess.notFound
			count: 2
			path: system/src/Mcp/Tools.php

		-
			message: '#^Parameter \#1 \$array \(list\<array\{draft\?\: true, nazev\: string, styl\: non\-empty\-array\<string, mixed\>\|stdClass, css\: string\}\>\) of array_values is already a list, call has no effect\.$#'
			identifier: arrayValues.list
			count: 1
			path: system/src/Mcp/Tools.php

		-
			message: '#^Constant Kaleta\\Mcp\\Translator\:\:TOOLS \(array\<string, array\<int, array\<string, mixed\>\|string\>\>\) does not accept value array\{site_info\: array\{''info_o_webu'', ''Site name, home…'', array\{\}\}, list_pages\: array\{''seznam_stranek'', ''Pages of the site …'', array\{\}\}, get_page\: array\{''nacti_stranku'', ''The whole page…'', array\{id\: array\{''id'', ''Page ID''\}\}\}, create_page\: array\{''vytvor_stranku'', ''Creates a page …'', array\{''\*stranka''\}\}, update_page\: array\{''uprav_stranku'', ''Changes the given…'', array\{id\: array\{''id'', ''Page ID''\}, 0\: ''\*stranka''\}\}, get_menu\: array\{''nacti_menu'', ''The site menu \(main…'', array\{location\: array\{''umisteni'', ''main \(default\) \|…''\}, language\: array\{''jazyk'', ''language version …''\}\}\}, save_menu\: array\{''uloz_menu'', ''Saves the whole…'', array\{location\: array\{''umisteni'', ''main \| footer''\}, language\: array\{''jazyk'', ''language version …''\}, items\: array\{''polozky'', ''menu items''\}\}\}, builder_schema\: array\{''stavba_schema'', ''How a page is put…'', array\{elements\: array\{''prvky'', ''element types to…''\}, full\: array\{''uplne'', ''true \= the whole…''\}\}\}, \.\.\.\}\.$#'
			identifier: classConstant.value
			count: 1
			path: system/src/Mcp/Translator.php

		-
			message: '#^Match expression does not handle remaining value\: mixed$#'
			identifier: match.unhandled
			count: 1
			path: system/src/Mcp/Translator.php

		-
			message: '#^Parameter \#1 \$array \(list\<string\>\) of array_values is already a list, call has no effect\.$#'
			identifier: arrayValues.list
			count: 3
			path: system/src/Mcp/Vocabulary.php
